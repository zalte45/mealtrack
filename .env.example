# ==============================================================================
# MealTrack — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# For local Docker development (docker-compose.yml):
DATABASE_URL="postgresql://mealtrack:mealtrack_dev_password@localhost:5432/mealtrack"

# For production (Neon, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/mealtrack?sslmode=require"

# ------------------------------------------------------------------------------
# Auth.js (NextAuth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET_MIN_32_CHARS"

# Required for Auth.js v5
# AUTH_TRUST_HOST=true   # Enable on Vercel / behind a proxy

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="MealTrack"

# Timezone for business date calculations (should match Provider timezone)
# TZ="Asia/Kolkata"
